{
    "name": "meskerfinancial/my-app",
    "description": "Multi-tenant PHP application",
    "type": "project",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "authors": [
        {
            "name": "donnamesker"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "vlucas/phpdotenv": "^5.7",
        "twbs/bootstrap-icons": "^1.13"
    },
    "scripts": {
        "post-install-cmd": [
            "php -r \"@mkdir('public/assets/css/fonts', 0755, true); copy('vendor/twbs/bootstrap-icons/font/bootstrap-icons.css', 'public/assets/font/bootstrap-icons.css'); copy('vendor/twbs/bootstrap-icons/font/fonts/bootstrap-icons.woff', 'public/assets/font/bootstrap-icons.woff'); copy('vendor/twbs/bootstrap-icons/font/fonts/bootstrap-icons.woff2', 'public/assets/font/bootstrap-icons.woff2');\""
        ]
    }
}
